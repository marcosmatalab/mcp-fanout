# Runs and captured artifacts. NEVER commit a run: it may contain salted digests
# tied to a specific server. The gate (docs/THE-GATE.md rule 3) forbids server or
# org names in anything published; the simplest enforcement is to not track runs.
/runs/
*.pcap
*.mitm

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Local CA material generated by mitmproxy. Secret by construction, never commit.
/harness/ca/
*.pem
*.crt
*.key

# OS / editor
.DS_Store
.idea/
.vscode/
ENCARGO-corpus.md
